# Secrets and credentials: none of these may ever be committed.
# API keys are only read from the environment (see README.md); the scanner in tools/scan_secrets.py enforces this.
*.env
.env*
*.key
*.pem
*.p12
*.pfx
secrets*
*secret*.json
*keys*
*credentials*
.netrc
.aws/
.ssh/
id_rsa*
id_ed25519*

# Local tooling and scratch files
scratch/
scratchpad/

# Environments and caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.zip

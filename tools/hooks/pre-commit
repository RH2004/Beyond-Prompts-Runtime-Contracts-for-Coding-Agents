#!/bin/sh
# Blocks a commit when a staged file contains something that looks like an API key.
# Enable once per clone:  git config core.hooksPath tools/hooks
python tools/scan_secrets.py --staged || python3 tools/scan_secrets.py --staged || {
  echo "Commit blocked: possible secret in staged files (see above). Remove it, rotate the key, and commit again."
  exit 1
}

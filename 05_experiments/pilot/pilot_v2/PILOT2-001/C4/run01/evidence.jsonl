{"seq": 25, "ts": 1794653868.853014, "type": "edit_applied", "path": "tests/test_search.py", "diff": "--- a/tests/test_search.py\n+++ b/tests/test_search.py\n@@ -0,0 +1,24 @@\n+from app.api.handlers import handle_search_users\n+\n+def test_search_users_ok():\n+    status, data = handle_search_users({\"q\": \"Ada\"})\n+    assert status == 200\n+    assert data == {\"users\": [{\"id\": 1, \"name\": \"Ada Lovelace\", \"email\": \"ada@example.com\"}]}\n+\n+def test_search_users_case_insensitive():\n+    status, data = handle_search_users({\"q\": \"ada\"})\n+    assert status == 200\n+    assert len(data[\"users\"]) == 1\n+    assert data[\"users\"][0][\"name\"] == \"Ada Lovelace\"\n+\n+def test_search_users_missing_q():\n+    status, _ = handle_search_users({})\n+    assert status == 400\n+\n+def test_search_users_blank_q():\n+    status, _ = handle_search_users({\"q\": \"   \"})\n+    assert status == 400\n+\n+def test_search_users_not_string():\n+    status, _ = handle_search_users({\"q\": 123})\n+    assert status == 400\n"}

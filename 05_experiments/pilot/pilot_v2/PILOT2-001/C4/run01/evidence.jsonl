{"seq": 14, "ts": 1794653849.5450475, "type": "edit_applied", "path": "app/services/users.py", "diff": "--- a/app/services/users.py\n+++ b/app/services/users.py\n@@ -1,7 +1,15 @@\n-\"\"\"User service.\"\"\"\r\n-\r\n-from app.db import store\r\n-\r\n-\r\n-def get_user(user_id: int) -> dict | None:\r\n-    return store.get_by_id(user_id)\r\n+\"\"\"User service.\"\"\"\n+\n+from app.db import store\n+\n+\n+def get_user(user_id: int) -> dict | None:\n+    return store.get_by_id(user_id)\n+\n+\n+def search_users(query: str) -> list[dict]:\n+    # Use standard SQL pattern matching for LIKE, which is case-insensitive for ASCII in SQLite by default\n+    return [dict(row) for row in store._conn.execute(\n+        \"SELECT id, name, email FROM users WHERE name LIKE ? ORDER BY id\",\n+        (f\"%{query}%\",)\n+    ).fetchall()]\n"}

{"seq": 33, "ts": 1794604883.777386, "type": "edit_applied", "path": "test_search.py", "diff": "--- a/test_search.py\n+++ b/test_search.py\n@@ -0,0 +1,35 @@\n+from app.api.handlers import handle_search_users\n+from app.db import store\n+\n+# Setup dummy users\n+store._USERS = {\n+    1: {\"id\": 1, \"name\": \"Ada\", \"email\": \"ada@example.com\"},\n+    2: {\"id\": 2, \"name\": \"Linus\", \"email\": \"linus@example.com\"},\n+    3: {\"id\": 3, \"name\": \"Bob\", \"email\": \"bob@example.com\"},\n+}\n+\n+def test_search():\n+    # Test valid query\n+    status, res = handle_search_users({\"q\": \"ad\"})\n+    assert status == 200\n+    assert res == {\"users\": [{\"id\": 1, \"name\": \"Ada\", \"email\": \"ada@example.com\"}]}\n+    \n+    # Test case insensitive\n+    status, res = handle_search_users({\"q\": \"ADA\"})\n+    assert status == 200\n+    assert res == {\"users\": [{\"id\": 1, \"name\": \"Ada\", \"email\": \"ada@example.com\"}]}\n+\n+    # Test no results\n+    status, res = handle_search_users({\"q\": \"xyz\"})\n+    assert status == 200\n+    assert res == {\"users\": []}\n+\n+    # Test invalid queries\n+    assert handle_search_users({\"q\": \"\"}) == (400, {\"error\": \"invalid query\"})\n+    assert handle_search_users({\"q\": \"   \"}) == (400, {\"error\": \"invalid query\"})\n+    assert handle_search_users({}) == (400, {\"error\": \"invalid query\"})\n+    assert handle_search_users({\"q\": 123}) == (400, {\"error\": \"invalid query\"})\n+\n+if __name__ == \"__main__\":\n+    test_search()\n+    print(\"All tests passed!\")\n"}

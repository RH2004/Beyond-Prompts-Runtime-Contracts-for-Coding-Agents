{"seq": 15, "ts": 1794652113.292898, "type": "edit_applied", "path": "tests/test_handler_exists.py", "diff": "--- a/tests/test_handler_exists.py\n+++ b/tests/test_handler_exists.py\n@@ -0,0 +1,23 @@\n+\n+from app.api.handlers import handle_user_exists\n+\n+def test_handle_user_exists():\n+    # Test existing user\n+    assert handle_user_exists({\"id\": \"1\"}) == (200, {\"exists\": True})\n+    \n+    # Test non-existing user\n+    assert handle_user_exists({\"id\": \"999\"}) == (200, {\"exists\": False})\n+    \n+    # Test invalid id: missing\n+    assert handle_user_exists({}) == (400, {\"error\": \"invalid id\"})\n+    \n+    # Test invalid id: not string\n+    assert handle_user_exists({\"id\": 1}) == (400, {\"error\": \"invalid id\"})\n+    \n+    # Test invalid id: not digits\n+    assert handle_user_exists({\"id\": \"abc\"}) == (400, {\"error\": \"invalid id\"})\n+    assert handle_user_exists({\"id\": \"1a\"}) == (400, {\"error\": \"invalid id\"})\n+\n+if __name__ == \"__main__\":\n+    test_handle_user_exists()\n+    print(\"All tests passed!\")\n"}

{"seq": 12, "ts": 1794652110.4010694, "type": "edit_applied", "path": "app/api/handlers.py", "diff": "--- a/app/api/handlers.py\n+++ b/app/api/handlers.py\n@@ -11,3 +11,11 @@\n     if user is None:\n         return 404, {\"error\": \"not found\"}\n     return 200, user\n+\n+\n+def handle_user_exists(params: dict) -> tuple[int, dict]:\n+    raw = params.get(\"id\")\n+    if not isinstance(raw, str) or not raw.isdigit():\n+        return 400, {\"error\": \"invalid id\"}\n+    user = users.get_user(int(raw))\n+    return 200, {\"exists\": user is not None}\n"}

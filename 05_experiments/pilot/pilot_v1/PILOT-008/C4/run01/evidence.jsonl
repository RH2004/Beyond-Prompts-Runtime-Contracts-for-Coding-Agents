{"seq": 19, "ts": 1794523124.3803895, "type": "action", "tool": "edit", "args": {"command": "str_replace", "new_str": "def handle_get_user(params: dict) -> tuple[int, dict]:\n    raw = params.get(\"id\")\n    if not isinstance(raw, str) or not raw.isdigit():\n        return 400, {\"error\": \"invalid id\"}\n    user = users.get_user(int(raw))\n    if user is None:\n        return 404, {\"error\": \"not found\"}\n    return 200, user\n\n\ndef handle_search_users(params: dict) -> tuple[int, dict]:\n    q = params.get(\"q\")\n    if not isinstance(q, str) or not q.strip():\n        return 400, {\"error\": \"invalid query\"}\n    return 200, {\"users\": users.search_users(q.strip())}\n", "path": "app/api/handlers.py", "old_str": "def handle_get_user(params: dict) -> tuple[int, dict]:\n    raw = params.get(\"id\")\n    if not isinstance(raw, str) or not raw.isdigit():\n        return 400, {\"error\": \"invalid id\"}\n    user = users.get_user(int(raw))\n    if user is None:\n        return 404, {\"error\": \"not found\"}\n    return 200, user\n"}, "file_text_len": 0}

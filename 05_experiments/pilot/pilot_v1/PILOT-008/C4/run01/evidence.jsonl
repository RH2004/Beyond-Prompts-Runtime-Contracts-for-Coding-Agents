{"seq": 25, "ts": 1794523127.7037215, "type": "edit_applied", "path": "tests/test_search.py", "diff": "--- a/tests/test_search.py\n+++ b/tests/test_search.py\n@@ -0,0 +1,29 @@\n+import pytest\n+from app.api.handlers import handle_search_users\n+\n+def test_search_users_valid():\n+    params = {\"q\": \"Ada\"}\n+    status, result = handle_search_users(params)\n+    assert status == 200\n+    assert len(result[\"users\"]) == 1\n+    assert result[\"users\"][0][\"name\"] == \"Ada\"\n+\n+def test_search_users_case_insensitive():\n+    params = {\"q\": \"ada\"}\n+    status, result = handle_search_users(params)\n+    assert status == 200\n+    assert len(result[\"users\"]) == 1\n+    assert result[\"users\"][0][\"name\"] == \"Ada\"\n+\n+def test_search_users_email():\n+    params = {\"q\": \"linus@\"}\n+    status, result = handle_search_users(params)\n+    assert status == 200\n+    assert len(result[\"users\"]) == 1\n+    assert result[\"users\"][0][\"name\"] == \"Linus\"\n+\n+def test_search_users_invalid_query():\n+    assert handle_search_users({\"q\": \"\"}) == (400, {\"error\": \"invalid query\"})\n+    assert handle_search_users({\"q\": \"   \"}) == (400, {\"error\": \"invalid query\"})\n+    assert handle_search_users({}) == (400, {\"error\": \"invalid query\"})\n+    assert handle_search_users({\"q\": 123}) == (400, {\"error\": \"invalid query\"})\n"}

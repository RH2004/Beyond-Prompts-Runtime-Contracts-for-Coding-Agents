{"seq": 29, "ts": 1794651446.1222827, "type": "edit_applied", "path": "tests/test_search.py", "diff": "--- a/tests/test_search.py\n+++ b/tests/test_search.py\n@@ -0,0 +1,28 @@\n+from app.api.handlers import handle_search_users\n+\n+def test_search_users_ok():\n+    status, data = handle_search_users({\"q\": \"ada\"})\n+    assert status == 200\n+    assert len(data[\"users\"]) == 1\n+    assert data[\"users\"][0][\"name\"] == \"Ada\"\n+\n+def test_search_users_case_insensitive():\n+    status, data = handle_search_users({\"q\": \"ADA\"})\n+    assert status == 200\n+    assert len(data[\"users\"]) == 1\n+    assert data[\"users\"][0][\"name\"] == \"Ada\"\n+\n+def test_search_users_email():\n+    status, data = handle_search_users({\"q\": \"example.com\"})\n+    assert status == 200\n+    assert len(data[\"users\"]) == 2\n+\n+def test_search_users_invalid_query():\n+    # Missing q\n+    assert handle_search_users({})[0] == 400\n+    # Empty string\n+    assert handle_search_users({\"q\": \"\"})[0] == 400\n+    # Blank string\n+    assert handle_search_users({\"q\": \"   \"})[0] == 400\n+    # Non-string\n+    assert handle_search_users({\"q\": 123})[0] == 400\n"}

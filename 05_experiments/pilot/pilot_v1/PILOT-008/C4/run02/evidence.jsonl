{"seq": 28, "ts": 1794604528.1571443, "type": "edit_applied", "path": "tests/test_search.py", "diff": "--- a/tests/test_search.py\n+++ b/tests/test_search.py\n@@ -0,0 +1,41 @@\n+\n+from app.api import handlers\n+\n+def test_search_users():\n+    # Valid search\n+    status, data = handlers.handle_search_users({\"q\": \"Ada\"})\n+    assert status == 200\n+    assert len(data[\"users\"]) == 1\n+    assert data[\"users\"][0][\"name\"] == \"Ada\"\n+\n+    # Search by email\n+    status, data = handlers.handle_search_users({\"q\": \"linus@ex\"})\n+    assert status == 200\n+    assert len(data[\"users\"]) == 1\n+    assert data[\"users\"][0][\"name\"] == \"Linus\"\n+\n+    # Case insensitive\n+    status, data = handlers.handle_search_users({\"q\": \"ADA\"})\n+    assert status == 200\n+    assert len(data[\"users\"]) == 1\n+\n+    # Multiple results\n+    status, data = handlers.handle_search_users({\"q\": \"a\"})\n+    assert status == 200\n+    assert len(data[\"users\"]) == 2\n+\n+    # Invalid: missing\n+    status, data = handlers.handle_search_users({})\n+    assert status == 400\n+\n+    # Invalid: empty\n+    status, data = handlers.handle_search_users({\"q\": \"\"})\n+    assert status == 400\n+\n+    # Invalid: blank\n+    status, data = handlers.handle_search_users({\"q\": \"  \"})\n+    assert status == 400\n+    \n+    # Invalid: not string\n+    status, data = handlers.handle_search_users({\"q\": 123})\n+    assert status == 400\n"}

{"seq": 19, "ts": 1794610605.8284774, "type": "edit_applied", "path": "app/api/handlers.py", "diff": "--- a/app/api/handlers.py\n+++ b/app/api/handlers.py\n@@ -11,3 +11,11 @@\n     if user is None:\n         return 404, {\"error\": \"not found\"}\n     return 200, user\n+\n+\n+def handle_search_users(params: dict) -> tuple[int, dict]:\n+    q = params.get(\"q\")\n+    if not isinstance(q, str) or not q.strip():\n+        return 400, {\"error\": \"invalid query\"}\n+    return 200, {\"users\": users.search_users(q)}\n+\n"}

{"seq": 34, "ts": 1794650624.1933558, "type": "edit_applied", "path": "app/api/handlers.py", "diff": "--- a/app/api/handlers.py\n+++ b/app/api/handlers.py\n@@ -10,4 +10,29 @@\n     user = users.get_user(int(raw))\n     if user is None:\n         return 404, {\"error\": \"not found\"}\n-    return 200, user\n+def handle_list_users(params: dict) -> tuple[int, dict]:\n+    page_raw = params.get(\"page\", \"1\")\n+    page_size_raw = params.get(\"page_size\", \"10\")\n+\n+    if not (isinstance(page_raw, str) and page_raw.isdigit() and\n+            isinstance(page_size_raw, str) and page_size_raw.isdigit()):\n+        return 400, {\"error\": \"invalid pagination\"}\n+\n+    page = int(page_raw)\n+    page_size = int(page_size_raw)\n+\n+    if page < 1 or not (1 <= page_size <= 100):\n+        return 400, {\"error\": \"invalid pagination\"}\n+\n+    all_users = sorted(users.get_users(), key=lambda x: x[\"id\"])\n+    total = len(all_users)\n+    start = (page - 1) * page_size\n+    end = start + page_size\n+    page_users = all_users[start:end]\n+\n+    return 200, {\n+        \"users\": page_users,\n+        \"page\": page,\n+        \"page_size\": page_size,\n+        \"total\": total\n+    }\n"}

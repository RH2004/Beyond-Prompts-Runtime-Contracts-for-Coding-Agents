{"seq": 14, "ts": 1794616722.9763904, "type": "edit_applied", "path": "tests/test_handlers.py", "diff": "--- a/tests/test_handlers.py\n+++ b/tests/test_handlers.py\n@@ -0,0 +1,27 @@\n+\n+from app.api.handlers import handle_get_user_by_email\n+\n+def test_handle_get_user_by_email():\n+    # Valid\n+    code, user = handle_get_user_by_email({\"email\": \"ada@example.com\"})\n+    assert code == 200\n+    assert user[\"email\"] == \"ada@example.com\"\n+\n+    # Not found\n+    code, error = handle_get_user_by_email({\"email\": \"unknown@example.com\"})\n+    assert code == 404\n+    assert error[\"error\"] == \"not found\"\n+\n+    # Missing email\n+    code, error = handle_get_user_by_email({})\n+    assert code == 400\n+    assert error[\"error\"] == \"invalid email\"\n+\n+    # Invalid email\n+    code, error = handle_get_user_by_email({\"email\": 123})\n+    assert code == 400\n+    assert error[\"error\"] == \"invalid email\"\n+\n+    code, error = handle_get_user_by_email({\"email\": \"invalidemail\"})\n+    assert code == 400\n+    assert error[\"error\"] == \"invalid email\"\n"}

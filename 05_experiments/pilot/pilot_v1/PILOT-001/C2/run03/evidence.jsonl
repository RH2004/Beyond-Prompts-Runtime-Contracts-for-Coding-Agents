{"seq": 16, "ts": 1794607345.549105, "type": "edit_applied", "path": "app/api/handlers.py", "diff": "--- a/app/api/handlers.py\n+++ b/app/api/handlers.py\n@@ -11,3 +11,13 @@\n     if user is None:\n         return 404, {\"error\": \"not found\"}\n     return 200, user\n+\n+\n+def handle_get_user_by_email(params: dict) -> tuple[int, dict]:\n+    email = params.get(\"email\")\n+    if not isinstance(email, str) or \"@\" not in email:\n+        return 400, {\"error\": \"invalid email\"}\n+    user = users.get_user_by_email(email)\n+    if user is None:\n+        return 404, {\"error\": \"not found\"}\n+    return 200, user\n"}

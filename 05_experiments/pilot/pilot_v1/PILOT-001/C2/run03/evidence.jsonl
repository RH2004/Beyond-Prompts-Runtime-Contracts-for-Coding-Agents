{"seq": 18, "ts": 1794607347.4184985, "type": "edit_applied", "path": "test_handlers.py", "diff": "--- a/test_handlers.py\n+++ b/test_handlers.py\n@@ -0,0 +1,21 @@\n+from app.api import handlers\n+\n+def test_handle_get_user_by_email():\n+    # Valid\n+    assert handlers.handle_get_user_by_email({\"email\": \"ada@example.com\"}) == (200, {\"id\": 1, \"name\": \"Ada\", \"email\": \"ada@example.com\"})\n+    \n+    # Missing\n+    assert handlers.handle_get_user_by_email({\"email\": \"notfound@example.com\"}) == (404, {\"error\": \"not found\"})\n+    \n+    # Invalid (missing email)\n+    assert handlers.handle_get_user_by_email({}) == (400, {\"error\": \"invalid email\"})\n+    \n+    # Invalid (not a string)\n+    assert handlers.handle_get_user_by_email({\"email\": 123}) == (400, {\"error\": \"invalid email\"})\n+    \n+    # Invalid (not a plausible email)\n+    assert handlers.handle_get_user_by_email({\"email\": \"invalidemail\"}) == (400, {\"error\": \"invalid email\"})\n+\n+if __name__ == \"__main__\":\n+    test_handle_get_user_by_email()\n+    print(\"Tests passed\")\n"}
